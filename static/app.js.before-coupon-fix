async function go(
  page = "dashboard",
  id,
) {
  clearInterval(
    S.timer,
  );

  S.page = page;
  S.pageId = id;

  if (
    page !== "scan" &&
    location.pathname.startsWith(
      "/charge/",
    )
  ) {
    history.replaceState(
      null,
      "",
      "/",
    );

    S.scanNumber =
      null;
  }

  const v =
    ++S.version;

  $("#modal").close();

  shell();

  $("#content").innerHTML =
    tr(
      '<div class="loading">姝ｅ湪鍔犺浇鈥?/div>',
    );

  try {
    const html =
      await (
        renderers[
          page
        ]?.(id) ||
        empty(
          tr(
            "椤甸潰涓嶅瓨鍦?,
          ),
        )
      );

    if (
      v !==
      S.version
    ) {
      return;
    }

    $("#content")
      .innerHTML =
        html;

    if (
      page ===
        "charging" &&
      $("#live-energy")
    ) {
      S.timer =
        setInterval(
          async () => {
            try {
              const o =
                await api(
                  `/orders/${S.liveId}/receipt`,
                );

              if (
                v !==
                S.version
              ) {
                return;
              }

              if (
                ![
                  "charging",
                  "reserved",
                ].includes(
                  o.status,
                )
              ) {
                await go(
                  "charging",
                );

                return;
              }

              $("#live-energy")
                .textContent =
                  Number(
                    o.energy,
                  ).toFixed(
                    3,
                  );

              $("#live-amount")
                .textContent =
                  "楼 " +
                  yuan(
                    o.amount_cents,
                  );

              $("#live-time")
                .textContent =
                  Math.floor(
                    o.simulated_seconds /
                      60,
                  ) +
                  tr(
                    " 鍒嗛挓",
                  );
            } catch (e) {
              clearInterval(
                S.timer,
              );

              toast(
                e.message,
              );
            }
          },

          3000,
        );
    }
  } catch (e) {
    if (
      v !==
      S.version
    ) {
      return;
    }

    $("#content")
      .innerHTML =
        empty(
          esc(
            e.message,
          ),
        );

    if (
      e.status === 401
    ) {
      await boot();
    }
  }
}

async function refresh() {
  const s =
    await api(
      "/session",
    );

  S.user =
    s.user;

  S.csrf =
    s.csrf;

  S.scale =
    s.time_scale;

  if (!s.user) {
    loginView();

    throw Error(
      tr(
        "璇烽噸鏂扮櫥褰?,
      ),
    );
  }
}

async function afterLogin() {
  await adoptAccountPreferences();

  if (
    S.scanNumber &&
    S.user.role ===
      "user"
  ) {
    await go(
      "scan",
      S.scanNumber,
    );
  } else {
    await go(
      "dashboard",
    );
  }
}

