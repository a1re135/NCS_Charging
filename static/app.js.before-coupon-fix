function renderStationChargers() {
  const f =
    S.chargerFilter ||
    {};

  let chargers =
    (
      S.detailChargers ||
      []
    ).filter(
      (c) =>
        (
          !f.status ||
          c.status ===
            f.status
        ) &&
        (
          !f.kind ||
          c.kind ===
            f.kind
        ),
    );

  chargers = [
    ...chargers,
  ];

  if (
    f.sort === "usage"
  ) {
    chargers.sort(
      (a, b) =>
        b.total_count -
        a.total_count,
    );
  } else {
    chargers.sort(
      (a, b) =>
        a.number.localeCompare(
          b.number,
        ),
    );
  }

  const target =
    $("#charger-list");

  if (target) {
    target.innerHTML =
      stationChargersTable(
        chargers,
      );
  }
}

