      );

      $(
        "#profile-form [name=avatar]",
      ).value =
        b.dataset.color;

      break;

    case "edit-station":
      editStation(id);
      break;

    case "delete-station":
      confirmModal(
        tr(
          "鍒犻櫎鐢电珯",
        ),

        tr(
