# Application
NCS_SECRET_KEY=replace-me
NCS_CAPACITY_LEVEL=L1

# Deployment
NCS_COOKIE_SECURE=0
NCS_TRUST_PROXY=0

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ncs_charging
